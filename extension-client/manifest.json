{
  "manifest_version": 3,
  "name": "eTeacher Formative AI Assistant",
  "version": "1.0.0",
  "description": "Asistente de retroalimentación formativa Human-in-the-Loop para Programino eTeacher.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://programino.eteacher.be/*",
    "https://eateacher.zer4c.dev/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://programino.eteacher.be/*"
      ],
      "css": [
        "src/styles/panel.css"
      ],
      "js": [
        "src/content/i18n.js",
        "src/content/storage-service.js",
        "src/content/telemetry-service.js",
        "src/content/network-interceptor.js",
        "src/content/editor-adapter.js",
        "src/content/dom-adapter.js",
        "src/content/api-client.js",
        "src/content/ui-panel.js",
        "src/content/chat-panel.js",
        "src/content/content-main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
